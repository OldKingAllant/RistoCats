{
  "openapi": "3.0.3",
  "info": {
    "title": "Ristocats API",
    "description": "This is the API for the project RistoCats, a restaurant management system.",
    "contact": {
      "url": "https://github.com/OldKingAllant/RistoCats"
    },
    "license": {
      "name": "GNU GPL 3.0",
      "url": "https://www.gnu.org/licenses/gpl-3.0.html"
    },
    "version": "1.0"
  },
  "externalDocs": {
    "description": "GitHub",
    "url": "https://github.com/OldKingAllant/RistoCats"
  },
  "tags": [
    {
      "name": "static",
      "description": "Public and static files"
    },
    {
      "name": "alive",
      "description": "Verify if server is up"
    },
    {
      "name": "users",
      "description": "Operations about user"
    },
    {
      "name": "menu",
      "description": "Operations about menu and dishes"
    },
    {
      "name": "orders",
      "description": "Operations about orders"
    },
    {
      "name": "tables",
      "description": "Operations about tables"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Get index page",
        "description": "Returns the index.html page",
        "operationId": "getIndex",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/static": {
      "get": {
        "tags": [
          "static"
        ],
        "summary": "Get static public pages",
        "description": "Provides access to static pages",
        "operationId": "getStatic",
        "responses": {
          "200": {
            "description": "The file",
            "content": {
              "text/html": {}
            }
          },
          "404": {
            "description": "File not found"
          }
        }
      }
    },
    "/alive": {
      "get": {
        "tags": [
          "alive"
        ],
        "summary": "Check if server is UP",
        "description": "Returns server status",
        "operationId": "checkStatus",
        "responses": {
          "200": {
            "description": "Server is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Status"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/verify": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Verify jwt token",
        "description": "Verifies jwt token and returns 200 or 401/400",
        "operationId": "verifyToken",
        "parameters": [
          {
            "name": "jwt",
            "in": "query",
            "description": "jwt token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "token is valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidRequest"
                }
              }
            }
          },
          "400": {
            "description": "query is empty"
          },
          "401": {
            "description": "invalid/missing token"
          }
        }
      }
    },
    "/users/loginurl": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get login URL",
        "description": "Generate login url and return it",
        "operationId": "getLoginUrl",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUrl"
                }
              }
            }
          }
        }
      }
    },
    "/users/login": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Perform login",
        "description": "Generates JWT and returns it",
        "operationId": "login",
        "responses": {
          "200": {
            "description": "jwt created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jwt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "empty query"
          },
          "401": {
            "description": "invalid google code/invalid email/..."
          }
        }
      }
    },
    "/users/home": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get home",
        "description": "Returns the homepage of the logged in user",
        "operationId": "getHome",
        "responses": {
          "301": {
            "description": "Redirect",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing token/invalid token/expired token"
          }
        }
      }
    },
    "/menu/overview": {
      "get": {
        "tags": [
          "menu"
        ],
        "summary": "Menu",
        "description": "Returns the current menu",
        "operationId": "getMenu",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "description": "Language",
            "required": true,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Menu retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Dish"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing lang param"
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/menu/{dishid}/properties": {
      "get": {
        "tags": [
          "menu"
        ],
        "summary": "Properties",
        "description": "Get properties of specific dish",
        "operationId": "getDishProp",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "description": "Language",
            "required": true,
            "schema": {
              "type": "string",
              "example": "en"
            }
          },
          {
            "name": "dishid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dish"
                }
              }
            }
          },
          "400": {
            "description": "Missing lang param"
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/menu/all_dishes": {
      "get": {
        "tags": [
          "menu"
        ],
        "summary": "All dishes",
        "description": "Get list of all dishes",
        "operationId": "getAllDishes",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "description": "Language",
            "required": true,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieved all dishes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Dish"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing lang param"
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/menu/modify": {
      "post": {
        "tags": [
          "menu"
        ],
        "summary": "Modify menu",
        "description": "Add or remove dishes from menu",
        "operationId": "modifyMenu",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "enable": {
                      "type": "string",
                      "example": "Y/N"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation"
          },
          "400": {
            "description": "Invalid format"
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/tables/free": {
      "get": {
        "tags": [
          "tables"
        ],
        "summary": "Get list of free tables",
        "description": "",
        "operationId": "getFreeTables",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Table"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/tables/{tableid}/status": {
      "post": {
        "tags": [
          "tables"
        ],
        "summary": "Set status",
        "description": "Modify table status",
        "operationId": "setTableStatus",
        "parameters": [
          {
            "name": "tableid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "enable": {
                    "type": "string",
                    "example": "Y/N"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation"
          },
          "400": {
            "description": "Invalid format"
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/orders/{tableid}/place": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Place an order",
        "description": "",
        "operationId": "placeOrder",
        "parameters": [
          {
            "name": "tableid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "description": "successful operation",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Order"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orderid": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/orders/remaining": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Get incomplete orders",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "list": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/orders/{orderid}/details": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Get order details",
        "parameters": [
          {
            "name": "orderid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order": {
                      "$ref": "#/components/schemas/Order"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/orders/{orderid}/dish/{dishid}": {
      "delete": {
        "tags": [
          "orders"
        ],
        "summary": "Modify order",
        "description": "Decrements dish quantity in order and/or deletes order",
        "parameters": [
          {
            "name": "orderid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dishid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "quantity",
            "in": "query",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/tables/all_tables": {
      "get": {
        "tags": [
          "tables"
        ],
        "summary": "Get all tables",
        "description": "",
        "operationId": "getAllTables",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Table"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token invalid"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "running"
          }
        }
      },
      "ValidRequest": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean",
            "example": "true"
          }
        }
      },
      "LoginUrl": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "google login url"
          }
        }
      },
      "Dish": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "ingredients": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "float"
          },
          "allergens": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "statistics": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "Table": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tableid": {
            "type": "integer",
            "format": "integer32"
          },
          "free": {
            "type": "boolean"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "tableid": {
            "type": "integer"
          },
          "dishes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "infos": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}